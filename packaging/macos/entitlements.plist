<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- .NET CoreCLR uses JIT / dynamic codegen, and loads the bundled (Apple-unsigned) .NET dylibs.
       These are the standard entitlements required to notarize a .NET app under the hardened runtime.
       Only needed for Tier C (Developer ID sign + notarize); ad-hoc local signing ignores them. -->
  <key>com.apple.security.cs.allow-jit</key>                        <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key> <true/>
  <key>com.apple.security.cs.disable-library-validation</key>       <true/>
</dict>
</plist>
