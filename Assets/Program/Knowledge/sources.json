// MapleStory RAG knowledge sources for the in-app chatbot.
//
// The chatbot reads these curated, authoritative sites (via the `maple_lookup` tool) to answer
// MapleStory questions instead of relying only on a generic web search. To grow the knowledge base,
// just add entries to "sources" below — no code change is needed. Comments and trailing commas are
// allowed (the loader skips them). See KnowledgeBase.cs for the schema.
//
// Selection is LANGUAGE-PRIORITIZED: the question's script is detected (ko / ja / zh / en) and a source
// whose "languages" contains that code is ranked first, then by topic overlap. So a Korean question
// prefers a Korean site.
//
// Per-source fields:
//   id         unique short id (required)
//   name       display name shown to the model and in the Sources list (required)
//   languages  ISO-639-1 codes the site is written in, e.g. ["ko"] — drives the language priority
//   region     optional MapleStory region tag (KMS / GMS / MSEA / TMS), informational
//   homepage   optional site root
//   summary    one line: what it covers + when to use it
//   topics     keywords/tags in any language, used to rank the source against the question
//   templates  page URL patterns; {placeholders} are filled by the model before fetching
//                urlTemplate  the pattern, e.g. "https://site/jobs/{job}/"
//                description  what the page contains + what the placeholder means
//                examples     a few fully-resolved sample URLs (few-shot for the model)
//   notes      optional guidance (e.g. how to map a class name to a URL slug)
{
  "sources": [
    {
      "id": "grandislibrary",
      "name": "Grandis Library",
      "languages": ["en"],
      "region": "GMS",
      "homepage": "https://grandislibrary.com/classes",
      "summary": "English class reference for every job: skill build path, link skill, inner ability, hyper skill passives, boost nodes / V matrix trios, base stats, and full active-skill breakdowns. Primary source for English class/skill questions.",
      "topics": [
        "class guide", "skill build", "build path", "link skill", "inner ability", "hyper skill", "hyper passive",
        "hyper stat", "boost nodes", "v matrix", "nodes", "trio", "hexa", "6th job", "5th job", "active skills",
        "base stats", "bossing", "training", "legion", "weapon", "stats"
      ],
      "templates": [
        {
          "urlTemplate": "https://grandislibrary.com/{group}/{class}",
          "description": "Per-class guide. {group} is the class group and {class} is the kebab-case class name — see notes for the full group->class map.",
          "examples": [
            "https://grandislibrary.com/explorers/hero",
            "https://grandislibrary.com/cygnus-knights/wind-archer",
            "https://grandislibrary.com/heroes/aran",
            "https://grandislibrary.com/resistance/demon-slayer",
            "https://grandislibrary.com/nova/kaiser",
            "https://grandislibrary.com/flora/adele",
            "https://grandislibrary.com/other/zero"
          ]
        }
      ],
      "notes": "URL is /{group}/{class}, both lowercase kebab-case. The class GROUP is not guessable from the class name, so use this map. explorers: hero, paladin, dark-knight, bishop, arch-mage-fire-poison, arch-mage-ice-lightning, night-lord, shadower, dual-blade, bowmaster, marksman, pathfinder, buccaneer, corsair, cannoneer. cygnus-knights: dawn-warrior, blaze-wizard, wind-archer, night-walker, thunder-breaker, mihile. heroes: aran, evan, mercedes, phantom, luminous, shade. resistance: blaster, battle-mage, wild-hunter, mechanic, demon-slayer, demon-avenger, xenon. nova: kaiser, kain, cadena, angelic-buster. sengoku: hayato, kanna. flora: adele, ark, illium, khali. anima: hoyoung, lara, ren. jianghu: lynn, mo-xuan. shine: sia-astelle, erel-light. other: zero, kinesis. If a class isn't listed, open https://grandislibrary.com/classes to find its path."
    },
    {
      "id": "mapleskill",
      "name": "MapleSkill",
      "languages": ["ko"],
      "region": "KMS",
      "homepage": "https://mapleskill.com/",
      "summary": "Korean data-driven class guides (based on the top-100 players): inner ability, hyper skills, link skills, special/boost cores, HEXA stats, job core order, union raid & artifact setups per job.",
      "topics": [
        "job guide", "class guide", "inner ability", "hyper skills", "link skills", "skill build",
        "core enhancement", "hexa stats", "union raid", "union artifact", "boss", "5th job", "6th job",
        "이너어빌리티", "이너", "하이퍼스킬", "하이퍼", "링크스킬", "링크", "스킬트리", "코어강화", "코강",
        "헥사", "헥사스탯", "유니온", "공격대", "아티팩트", "직업", "보스", "사냥"
      ],
      "templates": [
        {
          "urlTemplate": "https://mapleskill.com/jobs/{job}/",
          "description": "Per-job guide page. {job} is the lowercase English job slug used in the URL path.",
          "examples": [
            "https://mapleskill.com/jobs/hero/",
            "https://mapleskill.com/jobs/darkknight/",
            "https://mapleskill.com/jobs/bishop/",
            "https://mapleskill.com/jobs/bowmaster/",
            "https://mapleskill.com/jobs/nightlord/",
            "https://mapleskill.com/jobs/archmage-fp/"
          ]
        }
      ],
      "notes": "URL slugs are lowercase English class names, usually with no separator (darkknight, nightlord, soulmaster), except the two archmages which use a hyphen (archmage-fp, archmage-il). Korean name -> slug: 히어로=hero, 팔라딘=paladin, 다크나이트=darkknight, 소울마스터=soulmaster, 미하일=mikhail, 블래스터=blaster, 데몬슬레이어=demonslayer, 데몬어벤져=demonavenger, 아란=aran, 카이저=kaiser, 아델=adele, 렌=len, 제로=zero, 아크메이지(불독)=archmage-fp, 아크메이지(썬콜)=archmage-il, 비숍=bishop, 플레임위자드=flamewizard, 배틀메이지=battlemage, 에반=evan, 루미너스=luminous, 일리움=illium, 라라=lara, 키네시스=kinesis, 보우마스터=bowmaster, 신궁=marksman, 패스파인더=pathfinder, 윈드브레이커=windbreaker, 와일드헌터=wildhunter, 메르세데스=mercedes, 카인=kain, 나이트로드=nightlord, 섀도어=shadower, 듀얼블레이드=dualblade, 나이트워커=nightwalker, 제논=xenon, 팬텀=phantom, 카데나=cadena, 칼리=khali, 호영=hoyoung, 바이퍼=viper, 캡틴=captain, 캐논슈터=cannonshooter, 스트라이커=striker, 메카닉=mechanic, 은월=eunwol, 엔젤릭버스터=angelicbuster, 아크=ark."
    }
  ]
}
