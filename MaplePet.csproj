<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows head: the Win32 layer pins this to net10.0-windows. The shared Engine/
         Rendering/Views code stays source-portable for a future net10.0-macos head. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- CsWin32 needs a concrete architecture; several APIs (GetWindowLongPtr,
         SHAppBarMessage, APPBARDATA) cannot be generated for AnyCPU. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Program/icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- App version — the single source of truth. Bump these on release (keep the three in step) and
       add a CHANGELOG.md entry. <Version> drives InformationalVersion, which AppInfo reads at runtime
       to show "v1.0.0" in the Settings "About" row and the tray tooltip; AssemblyVersion/FileVersion
       and the metadata below feed the exe's Win32 file-properties (Details tab). -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>MaplePet</Product>
    <Description>A desktop pet that walks along your taskbar.</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundle the built-in footage (DefaultCharacter, footage), but NOT the user character store
         (read from disk at runtime) or loose import/export zips — embedding those would bloat the
         assembly with data the code never reads via avares://. -->
    <!-- icon.ico is both embedded in the exe (<ApplicationIcon>) AND bundled as an Avalonia resource:
         the window/tray icons load it via avares:// so Win32 can pick a purpose-authored frame per
         size. The user character store / loose zips stay out of the bundle (read from disk). -->
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Characters/**;Assets/*.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <!-- CsWin32 generates the Win32 P/Invoke bindings at build time from NativeMethods.txt -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Platform/Windows/NativeMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
