<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Two heads: the Windows head pins the Win32 layer to net10.0-windows; the portable head
         (net10.0) carries Engine/Rendering/Views/Api + the macOS platform impls, and also runs on the
         dev Mac. `dotnet run`/`build` on a multi-target project need `-f` — iterate with `-f net10.0`
         on macOS, `-f net10.0-windows` on Windows. CI builds each head on its native runner. -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Compiles the sandboxed scripting engine (Jint) for kind:script user commands. Drop this constant
         (and the Jint package below) to ship a declarative-only build; CommandScriptHost then reports a
         friendly "scripting unavailable" error instead. -->
    <DefineConstants>$(DefineConstants);TYPEPET_SCRIPTING</DefineConstants>
  </PropertyGroup>

  <!-- ============================ WINDOWS HEAD ============================ -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <OutputType>WinExe</OutputType>            <!-- no console window on Windows -->
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- CsWin32 needs a concrete architecture; several APIs (GetWindowLongPtr,
         SHAppBarMessage, APPBARDATA) cannot be generated for AnyCPU. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>     <!-- PerMonitorV2 DPI -->
    <ApplicationIcon>Assets/Program/icon.ico</ApplicationIcon>  <!-- PE icon -->
  </PropertyGroup>

  <!-- ===================== PORTABLE (macOS / Linux) HEAD ================== -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    <!-- AnyCPU so it builds/runs on Apple Silicon (arm64) and Intel alike; the published artifact is
         made RID-specific via `dotnet publish -r osx-arm64`. -->
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!-- App version — the single source of truth. Bump these on release (keep the three in step), add a
       CHANGELOG.md entry, and the macOS bundle's Info.plist version is injected from <Version>. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>TypePet</Product>
    <Description>A desktop pet that walks along your taskbar.</Description>
    <Authors>leonana69</Authors>
    <Copyright>Copyright © 2026 leonana69</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Bundled assets (icons + the built-in DefaultCharacter), both heads. The user character store and
       loose import/export zips stay out of the bundle (read from disk at runtime). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Characters/**;Assets/*.zip" />
  </ItemGroup>

  <!-- Cross-platform packages, both heads. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <PackageReference Include="Jint" Version="4.9.3" />
    <!-- Local MCP tool server (LLM control of the pet). The .AspNetCore package hosts it over
         Streamable HTTP and pulls in the ASP.NET Core shared framework referenced below. -->
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <!-- In-app chatbot backends. Anthropic = official Claude SDK; OpenAI = official SDK whose ChatClient
         accepts a custom Endpoint, so it also drives DeepSeek / Ollama / LM Studio (OpenAI-compatible). -->
    <PackageReference Include="Anthropic" Version="12.24.1" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <!-- HTML parsing for the keyless web tools: DuckDuckGo result scraping + web_fetch page→text. -->
    <PackageReference Include="AngleSharp" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Windows-only build inputs: CsWin32 generates the Win32 P/Invoke bindings from NativeMethods.txt. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <AdditionalFiles Include="Platform/Windows/NativeMethods.txt" />
    <!-- DPAPI for the Windows secret store (encrypts provider API keys at rest). Windows-only:
         WindowsSecretStore.cs compiles only in this head. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- Per-OS source partitioning: the SDK globs all *.cs, so exclude the off-platform folder from each
       head. Platform/Windows/** only compiles under -windows (CsWin32 types); Platform/Mac/** only
       under net10.0 (AppKit/CoreGraphics interop). -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Platform/Windows/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Remove="Platform/Mac/**/*.cs" />
  </ItemGroup>

  <!-- Dev tooling that lives in the repo but is NOT part of the app: tools/chargen is the standalone
       generator that draws the original default character (its own csproj + Main). Keep its sources out
       of the app compile so the SDK's **/*.cs glob doesn't pull in a second entry point. -->
  <ItemGroup>
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
